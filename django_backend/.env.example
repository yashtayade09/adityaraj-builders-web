# ===============================================
# OPTIONAL SETTINGS - you do NOT need a .env file to run locally.
# Copy this file to ".env" only when you want to change something.
# ===============================================

# Local testing (default): keep DEBUG True.
# For the live server set DEBUG="False" and a long random SECRET_KEY.
DEBUG="True"
SECRET_KEY="replace-this-with-a-long-random-secret-key"
ALLOWED_HOSTS="localhost,127.0.0.1"
# Live site only, e.g. "https://yourdomain.com"
CSRF_TRUSTED_ORIGINS=""

# Database: leave this commented out to use the simple built-in SQLite file (db.sqlite3).
# Only for a live PostgreSQL server:
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Owner login created by:  python manage.py create_owner
INITIAL_OWNER_USERNAME="adityaraj_owner"
INITIAL_OWNER_EMAIL="contact@adityarajbuilders.in"
INITIAL_OWNER_PASSWORD="Adityaraj@2026"

# Optional Cloudinary image storage
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
